{
  "name": "typeshift",
  "version": "0.1.1",
  "description": "A local-first TypeScript API compatibility checker that tells you whether declaration changes actually require a semver major release.",
  "keywords": [
    "typescript",
    "semver",
    "api",
    "compatibility",
    "breaking-changes",
    "declarations",
    "cli"
  ],
  "homepage": "https://github.com/hix-pro/typeshift#readme",
  "bugs": {
    "url": "https://github.com/hix-pro/typeshift/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hix-pro/typeshift.git"
  },
  "license": "MIT",
  "author": "hix-pro",
  "bin": {
    "typeshift": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsx src/cli.ts",
    "demo": "npm run build && node dist/cli.js compare examples/v1 examples/v2",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm test && npm run typecheck",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
